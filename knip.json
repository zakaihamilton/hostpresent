{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "paths": {
    "@/*": ["./src/*"]
  },
  "ignoreDependencies": [
    "@ffmpeg/core",
    "@ffmpeg/ffmpeg",
    "@ffmpeg/util",
    "jsdom"
  ],
  "entry": [
    "src/app/**/viewport.ts",
    "src/components/ui/Icons/index.ts",
    "src/public-scripts/sw.ts",
    "src/public-scripts/theme-init.ts",
    "public/sw.js",
    "public/theme-init.js",
    "public/recording/ffmpeg/*.js"
  ]
}
