{
  "name": "hostpresent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "jest",
    "test:unit": "jest",
    "test:automated": "npm run test:unit -- --runInBand && npm run build && npm run test:e2e:smoke",
    "test:e2e": "env -u FORCE_COLOR -u NO_COLOR playwright test",
    "test:e2e:smoke": "env -u FORCE_COLOR -u NO_COLOR playwright test tests/e2e/welcome-smoke.spec.js --project=chromium",
    "test:e2e:webrtc": "env -u FORCE_COLOR -u NO_COLOR RUN_WEBRTC_E2E=1 playwright test tests/e2e/meeting-webrtc.spec.js --project=chromium",
    "test:watch": "jest --watch",
    "health": "repnix check",
    "health:dead-code": "knip",
    "health:duplication": "jscpd src",
    "health:coverage": "c8 --all --reporter=text yarn test",
    "health:architecture": "depcruise --output-type json --config -- src",
    "health:licenses": "license-checker --json",
    "health:documentation": "markdownlint-cli2 \"**/*.md\" \"#node_modules\""
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "mediabunny": "^1.50.8",
    "next": "16.2.6",
    "peerjs": "^1.5.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@playwright/test": "^1.51.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "babel-plugin-react-compiler": "1.0.0",
    "c8": "^12.0.0",
    "dependency-cruiser": "^18.2.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jscpd": "^5.0.14",
    "jsdom": "^29.1.1",
    "knip": "^6.32.2",
    "license-checker": "^25.0.1",
    "markdownlint-cli2": "^0.23.2",
    "repnix": "^0.3.6"
  }
}
